// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  paymentIntentId String   @unique
  status          String   @default("confirmed")
  total           Float
  items           Json
  shippingData    Json
  shippingEmail   String
  trackingNumber  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shippingEmail])
  @@index([orderNumber])
}

model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  price         Float
  comparePrice  Float?
  images        String[]
  category      String
  subCategory   String?
  inStock       Boolean  @default(true)
  stockCount    Int      @default(0)
  sku           String?  @unique
  specs         Json?
  bulkPricing   Json?
  isFeatured    Boolean  @default(false)
  isPublished   Boolean  @default(true)
  rating        Float    @default(5.0)
  reviewCount   Int      @default(0)
  moq           Int?
  badge         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QuoteRequest {
  id          String   @id @default(cuid())
  productId   String
  productName String
  qty         Int
  name        String
  email       String
  organization String?
  country     String
  message     String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@index([email])
}

model WholesaleApplication {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  email         String   @unique
  phone         String?
  organization  String
  country       String
  monthlyVolume String
  categories    Json
  message       String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
}

model StockNotification {
  id        String   @id @default(cuid())
  email     String
  productId String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([email, productId])
  @@index([productId])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  passwordHash  String?
  role          String    @default("customer")
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
